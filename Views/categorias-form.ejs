<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= categoria ? 'Editar Categoria' : 'Nova Categoria' %> - Master Sound</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/CSS/estilos-dashboard.css">
  <style>
    .form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
    .form-group label { font-size: 0.85rem; font-weight: 600; color: #1e293b; }
    .form-group input, .form-group textarea {
      padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.9rem; outline: none;
    }
    .form-group input:focus, .form-group textarea:focus { border-color: #0A7E66; }
  </style>
</head>
<body>

  <header class="topbar">
    <div class="topbar-container">
      <div class="topbar-top">
        <a href="/dashboard" class="brand">
          <img src="/IMG/uploud/logoms.png" alt="Master Sound">
          <span>MASTER SOUND</span>
        </a>
        <div class="user-welcome">Bem-vindo, <strong>Administrador</strong></div>
      </div>
      <div class="topbar-nav">
        <span class="panel-title">Painel Administrativo</span>
        <nav class="nav-menu">
          <a href="/dashboard">Dashboard</a>
          <a href="/produtos">Produtos</a>
          <a href="/categorias" class="active">Categorias</a>
          <a href="/usuarios">Usuários</a>
          <a href="/" target="_blank">Ver Site</a>
          <a href="/admin" class="btn-sair">Sair</a>
        </nav>
      </div>
    </div>
  </header>

  <main class="main-content">
    <div class="card-box" style="max-width: 600px; margin: 0 auto;">
      <div class="card-box-header">
        <h1 style="font-size: 1.4rem; color: #0f172a;"><%= categoria ? 'Editar Categoria' : 'Cadastrar Nova Categoria' %></h1>
        <a href="/categorias" style="color: #64748b; text-decoration: none; font-size: 0.88rem;">← Voltar</a>
      </div>

      <form action="<%= categoria ? '/categorias/editar/' + categoria.id : '/categorias/novo' %>" method="POST">
        <div class="form-group">
          <label for="nome">Nome da Categoria:</label>
          <input type="text" id="nome" name="nome" placeholder="Ex: Vinil Clássico, Equipamentos" value="<%= categoria ? categoria.nome : '' %>" required>
        </div>

        <div class="form-group">
          <label for="descricao">Descrição:</label>
          <textarea id="descricao" name="descricao" rows="3"><%= categoria ? categoria.descricao : '' %></textarea>
        </div>

        <button type="submit" class="btn-novo" style="border:none; cursor:pointer; width:100%; padding:12px; font-size:0.95rem; margin-top:8px;">
          <%= categoria ? 'Salvar Alterações' : 'Cadastrar Categoria' %>
        </button>
      </form>
    </div>
  </main>

</body>
</html>