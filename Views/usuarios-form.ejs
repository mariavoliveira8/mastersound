<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= usuario ? 'Editar Usuário' : 'Novo Usuário' %> - Master Sound</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/CSS/estilos-dashboard.css">
  <style>
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
    .form-group.full { grid-column: 1 / -1; }
    .form-group label { font-size: 0.85rem; font-weight: 600; color: #1e293b; }
    .form-group input {
      padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.9rem; outline: none;
    }
    .form-group input:focus { border-color: #0A7E66; }
  </style>
</head>
<body>

  <header class="topbar">
    <div class="topbar-container">
      <div class="topbar-top">
        <a href="/dashboard" class="brand">
          <img src="/IMG/uploud/logoms.png" alt="Master Sound">
          <span>MASTER SOUND</span>
        </a>
        <div class="user-welcome">Bem-vindo, <strong>Administrador</strong></div>
      </div>
      <div class="topbar-nav">
        <span class="panel-title">Painel Administrativo</span>
        <nav class="nav-menu">
          <a href="/dashboard">Dashboard</a>
          <a href="/produtos">Produtos</a>
          <a href="/categorias">Categorias</a>
          <a href="/usuarios" class="active">Usuários</a>
          <a href="/" target="_blank">Ver Site</a>
          <a href="/admin" class="btn-sair">Sair</a>
        </nav>
      </div>
    </div>
  </header>

  <main class="main-content">
    <div class="card-box" style="max-width: 700px; margin: 0 auto;">
      <div class="card-box-header">
        <h1 style="font-size: 1.4rem; color: #0f172a;"><%= usuario ? 'Editar Usuário' : 'Cadastrar Novo Usuário' %></h1>
        <a href="/usuarios" style="color: #64748b; text-decoration: none; font-size: 0.88rem;">← Voltar</a>
      </div>

      <%
        let dataFormatada = '';
        if (usuario && usuario.data_nascimento) {
          const d = new Date(usuario.data_nascimento);
          if (!isNaN(d.getTime())) {
            dataFormatada = d.toISOString().split('T')[0];
          }
        }
      %>

      <form action="<%= usuario ? '/usuarios/editar/' + usuario.id : '/usuarios/novo' %>" method="POST">
        <div class="form-grid">
          <div class="form-group full">
            <label for="nome">Nome Completo:</label>
            <input type="text" id="nome" name="nome" value="<%= usuario ? usuario.nome : '' %>" required>
          </div>

          <div class="form-group full">
            <label for="email">E-mail de Acesso:</label>
            <input type="email" id="email" name="email" value="<%= usuario ? usuario.email : '' %>" required>
          </div>

          <div class="form-group">
            <label for="cpf">CPF:</label>
            <input type="text" id="cpf" name="cpf" placeholder="00000000000" value="<%= usuario ? usuario.cpf : '' %>" required>
          </div>

          <div class="form-group">
            <label for="data_nascimento">Data de Nascimento:</label>
            <input type="date" id="data_nascimento" name="data_nascimento" value="<%= dataFormatada %>" required>
          </div>

          <div class="form-group full">
            <label for="senha">Senha:</label>
            <input type="password" id="senha" name="senha" value="<%= usuario ? usuario.senha : '' %>" required>
          </div>
        </div>

        <button type="submit" class="btn-novo" style="border:none; cursor:pointer; width:100%; padding:12px; font-size:0.95rem; margin-top:8px;">
          <%= usuario ? 'Salvar Alterações' : 'Cadastrar Usuário' %>
        </button>
      </form>
    </div>
  </main>

</body>
</html>